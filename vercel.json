{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/saldo.php" },
    { "source": "/cek_saldo.html", "destination": "/cek_saldo.html" }
  ],
  "functions": {
    "api/saldo.php": {
      "runtime": "php@8.2"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}

{
  "redirects": [
    {
      "source": "/soed-2/",
      "destination": "/maintenance/",
      "permanent": false
    },
    {
      "source": "/ujicoba/",
      "destination": "/tidaktersedia/",
      "permanent": true
    },
    {
      "source": "/seeb/",
      "destination": "/tidaktersedia/",
      "permanent": true
    },
    {
      "source": "/apprem/",
      "destination": "/tidaktersedia/",
      "permanent": true
    },
    {
      "source": "/rit/",
      "destination": "/maintenance/",
      "permanent": true
    },
    {
      "source": "/sosm1/",
      "destination": "/maintenance/",
      "permanent": true
    },
    {
      "source": "/sos4/",
      "destination": "/maintenance/",
      "permanent": true
    },
    {
      "source": "/suns/",
      "destination": "/maintenance/",
      "permanent": true
    },
    {
      "source": "/gll/",
      "destination": "/maintenance/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ujicoba/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/ujicoba2/:path*",
      "destination": "/index2.html"
    }
  ],
  "headers": [
    {
      "source": "/ujicoba/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/ujicoba2/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}

# ===============================
# 🔒 PROTECT DATABASE.JSON
# ===============================

<Files "database.json">
    Require all denied
</Files>

# Jika server masih pakai Apache lama (2.2)
<IfModule !mod_authz_core.c>
    <Files "database.json">
        Order allow,deny
        Deny from all
    </Files>
</IfModule>

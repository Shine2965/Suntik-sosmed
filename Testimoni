// Ganti dengan token dan chat_id kamu
const TELEGRAM_TOKEN = "8401312586:AAGivV7zgVWlFTKpCroRGC6sTEZxLbqG_ug";
const TELEGRAM_CHAT_ID = "@ShineShopOfficial";

function doPost(e) {
  // e.postData.contents berisi JSON yang dikirim dari web
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  let data;
  try {
    data = JSON.parse(e.postData.contents);
  } catch(err) {
    return ContentService
            .createTextOutput(JSON.stringify({status: "error", error: err.toString()}))
            .setMimeType(ContentService.MimeType.JSON);
  }
  const nama = data.nama || "";
  const rating = data.rating || 0;
  const testimoni = data.testimoni || "";

  const timestamp = new Date();

  // Simpan ke Sheet
  sheet.appendRow([timestamp, nama, rating, testimoni]);

  // Kirim ke Telegram
  const text = `⭐ *Testimoni Baru* \n👤 Nama: ${nama}\n🌟 Rating: ${rating}/5\n💬 "${testimoni}"`;
  try {
    UrlFetchApp.fetch(`https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage`, {
      method: "post",
      payload: {
        chat_id: TELEGRAM_CHAT_ID,
        text: text,
        parse_mode: "Markdown"
      }
    });
  } catch(err) {
    // jika gagal kirim, tetap sukses menyimpan
  }

  return ContentService
          .createTextOutput(JSON.stringify({status: "success"}))
          .setMimeType(ContentService.MimeType.JSON);
}

function doGet(e) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const rows = sheet.getDataRange().getValues();
  const results = [];
  // mulai dari i = 1 supaya melewati header
  for (let i = 1; i < rows.length; i++) {
    const row = rows[i];
    results.push({
      timestamp: row[0],
      nama: row[1],
      rating: row[2],
      testimoni: row[3]
    });
  }
  return ContentService
          .createTextOutput(JSON.stringify(results))
          .setMimeType(ContentService.MimeType.JSON);
}

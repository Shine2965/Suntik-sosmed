export default async function handler(req, res){
  if(req.method !== "POST"){
    return res.status(405).json({msg:"Method not allowed"});
  }

  const { stars, userid, payment, total } = req.body;

  const TOKEN = process.env.TELEGRAM_TOKEN;
  const OWNER = process.env.OWNER_ID;

  // pesan ke owner
  const ownerMsg = `
🚀 REQUEST CONVERT STARS

⭐ Stars: ${stars}
💰 Total: Rp ${total}

👤 User ID: ${userid}
💳 Payment: ${payment}
`;

  try{

    // kirim ke owner
    await fetch(`https://api.telegram.org/bot${TOKEN}/sendMessage`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        chat_id: OWNER,
        text: ownerMsg
      })
    });

    // kirim invoice ke user
    await fetch(`https://api.telegram.org/bot${TOKEN}/sendMessage`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        chat_id: userid,
        text: `💸 INVOICE CONVERT STARS

⭐ ${stars} Stars
💰 Rp ${total}

Klik tombol di bawah untuk konfirmasi convert`,
        reply_markup:{
          inline_keyboard:[
            [
              {
                text:"✅ Convert Stars",
                callback_data: JSON.stringify({
                  action:"convert",
                  stars,
                  total
                })
              }
            ]
          ]
        }
      })
    });

    return res.status(200).json({msg:"success"});

  }catch(e){
    return res.status(500).json({msg:"error", error:e.message});
  }
}
